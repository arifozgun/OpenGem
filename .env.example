# Environment Configuration
# Copy this file to .env and modify as needed

NODE_ENV=development

# Server port (default: 3050)
PORT=3050

# Bind address — defaults to 127.0.0.1 (loopback only) for safety.
# Production deployments behind nginx/Cloudflare should keep this as-is.
# Set to 0.0.0.0 only if you intentionally want to expose OpenGem directly.
# HOST=127.0.0.1

# OAuth redirect URI. Defaults to http://127.0.0.1:<PORT>/api/auth/callback.
# NOTE: OpenGem uses the Antigravity CLI's own (Desktop-app) Google credentials,
# so Google ONLY accepts loopback URLs here (127.0.0.1 / localhost). A custom
# public domain will fail with "Error 400: redirect_uri_mismatch". To link an
# account on a remote server, tunnel the loopback port to your machine instead
# (e.g. ssh -L 3050:localhost:3050 user@server) and open http://localhost:3050.
# Only override this if you supply your OWN OAuth client id/secret as well.
# OAUTH_REDIRECT_URI=http://127.0.0.1:3050/api/auth/callback

# Allowed CORS origins in production (comma-separated)
# Use * only for non-credentialed public API access. Admin routes stay same-origin.
# CORS_ORIGIN=https://yourdomain.com

# Which reverse proxies Express should trust for X-Forwarded-* headers.
# The default, loopback, is safe for local nginx/Passenger/Cloudflare tunnel setups.
# TRUST_PROXY=loopback

# Maximum JSON/urlencoded request body size. Keep conservative on public API servers.
# OPENGEM_BODY_LIMIT=10mb

# Runtime home for npm/global installs. OpenGem reads config.json, .env and data/
# from this directory when set. Keep this path private and backed up.
# OPENGEM_HOME=/opt/opengem

# Adaptive account balancer defaults. Lower these if Google returns repeated 429s
# for your account pool; raise cautiously only after watching request logs.
# OPENGEM_ACCOUNT_RATE_LIMIT_PER_MINUTE=45
# OPENGEM_PRO_ACCOUNT_RATE_LIMIT_PER_MINUTE=75
# OPENGEM_ACCOUNT_RATE_WINDOW_MS=60000
# OPENGEM_ACCOUNT_MAX_IN_FLIGHT=2
# OPENGEM_PRO_ACCOUNT_MAX_IN_FLIGHT=3
# OPENGEM_STREAM_ACCOUNT_MAX_IN_FLIGHT=2
# OPENGEM_MIN_GLOBAL_CONCURRENCY=3
# OPENGEM_MAX_GLOBAL_CONCURRENCY=24

# Config encryption key — auto-generated on first run if not set.
# This key is used to encrypt/decrypt sensitive values in config.json.
# ⚠️  DO NOT SHARE, COMMIT, OR LOSE THIS KEY.
# If lost, you will need to re-run setup to generate a new config.
# CONFIG_ENCRYPTION_KEY=<auto-generated-128-char-hex-string>
